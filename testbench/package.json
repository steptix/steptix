{
  "name": "testbench",
  "displayName": "TestBench",
  "publisher": "pkent",
  "version": "0.3.9",
  "description": "Edit and run ai-ui-automation natural-language tests inside VS Code",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension/extension.js",
  "categories": [
    "Other",
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "markdown"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "testbench",
          "title": "TestBench",
          "icon": "./icons/testbench.svg"
        }
      ]
    },
    "views": {
      "testbench": [
        {
          "id": "testbench.runner",
          "name": "Test Runner",
          "type": "webview",
          "icon": "./icons/testbench.svg",
          "contextualTitle": "TestBench"
        }
      ]
    },
    "configuration": {
      "title": "TestBench",
      "properties": {
        "testbench.defaultEnvFile": {
          "type": "string",
          "default": "",
          "description": "Absolute or workspace-relative path used when walk-up finds no .env next to (or above) the test file."
        },
        "testbench.consoleLogLevel": {
          "type": "string",
          "enum": ["", "silent", "error", "warn", "info", "debug"],
          "default": "",
          "description": "Console + output-panel log threshold for test runs. Leave blank to use the server's configured default. A test's '## Config: consoleLogLevel' setting overrides this."
        },
        "testbench.serverFileLogLevel": {
          "type": "string",
          "enum": ["", "off", "compact", "full"],
          "default": "",
          "description": "Per-run log file written by the server under reports/logs/. 'off' disables; 'compact' = log lines only; 'full' = log lines + AI request/response trace. Leave blank to use the server's configured default. A test's '## Config: serverFileLogLevel' setting overrides this."
        },
        "testbench.activeEnv": {
          "type": "string",
          "default": "",
          "description": "Active environment name. Selects '.env.<name>' (secrets/URLs) and 'data/<name>.json' (structured test data) for the next run. Leave blank for no env selection. Pick via the '🌐 env: ...' status-bar item or 'TestBench: Select Environment' command."
        },
        "testbench.testsGlob": {
          "type": "string",
          "default": "**/*.md",
          "description": "Glob pattern of files to consider as candidate tests in the Test Explorer. Files still must contain '## Steps' and not be marked 'type: skill' or 'disabled: true' in frontmatter. Narrow this (e.g. 'tests/**/*.md') for faster discovery on large repos."
        }
      }
    },
    "commands": [
      {
        "command": "testbench.runSelected",
        "title": "TestBench: Run Selected Step(s)",
        "icon": "$(play)"
      },
      {
        "command": "testbench.runAll",
        "title": "TestBench: Run All Steps",
        "icon": "$(run-all)"
      },
      {
        "command": "testbench.stop",
        "title": "TestBench: Stop Run",
        "icon": "$(debug-stop)"
      },
      {
        "command": "testbench.pause",
        "title": "TestBench: Pause Run",
        "icon": "$(debug-pause)"
      },
      {
        "command": "testbench.restartSession",
        "title": "TestBench: Close Session",
        "icon": "$(refresh)"
      },
      {
        "command": "testbench.toggleBreakpoint",
        "title": "TestBench: Toggle Breakpoint",
        "icon": "$(debug-breakpoint)"
      },
      {
        "command": "testbench.runStepHere",
        "title": "TestBench: Run This Step"
      },
      {
        "command": "testbench.resume",
        "title": "TestBench: Resume from Breakpoint",
        "icon": "$(debug-continue)"
      },
      {
        "command": "testbench.clearBreakpoints",
        "title": "TestBench: Clear All Breakpoints"
      },
      {
        "command": "testbench.clearStatuses",
        "title": "TestBench: Clear Run Statuses"
      },
      {
        "command": "testbench.revealEnvFile",
        "title": "TestBench: Reveal Resolved .env"
      },
      {
        "command": "testbench.showRunLog",
        "title": "TestBench: Show Run Log",
        "icon": "$(output)"
      },
      {
        "command": "testbench.dismissError",
        "title": "TestBench: Dismiss Error"
      },
      {
        "command": "testbench.selectEnv",
        "title": "TestBench: Select Environment"
      },
      {
        "command": "testbench.focusRunner",
        "title": "TestBench: Focus Runner Panel"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "testbench.runSelected",
          "when": "testbench.activeFile && !testbench.running && !testbench.paused",
          "group": "navigation@1"
        },
        {
          "command": "testbench.pause",
          "when": "testbench.activeFile && testbench.running",
          "group": "navigation@1"
        },
        {
          "command": "testbench.resume",
          "when": "testbench.activeFile && testbench.paused && !testbench.running",
          "group": "navigation@1"
        },
        {
          "command": "testbench.stop",
          "when": "testbench.activeFile && (testbench.running || testbench.paused)",
          "group": "navigation@2"
        },
        {
          "command": "testbench.restartSession",
          "when": "testbench.activeFile",
          "group": "navigation@3"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "testbench.toggleBreakpoint",
          "when": "testbench.activeFile",
          "group": "1_breakpoint@1"
        },
        {
          "command": "testbench.runStepHere",
          "when": "testbench.activeFile",
          "group": "2_run@1"
        },
        {
          "command": "testbench.clearBreakpoints",
          "when": "testbench.activeFile",
          "group": "3_clear@1"
        },
        {
          "command": "testbench.clearStatuses",
          "when": "testbench.activeFile",
          "group": "3_clear@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "testbench.runSelected",
        "key": "f5",
        "when": "editorTextFocus && testbench.activeFile && !testbench.running && !testbench.paused"
      },
      {
        "command": "testbench.pause",
        "key": "f5",
        "when": "editorTextFocus && testbench.activeFile && testbench.running"
      },
      {
        "command": "testbench.resume",
        "key": "f5",
        "when": "editorTextFocus && testbench.activeFile && testbench.paused && !testbench.running"
      },
      {
        "command": "testbench.stop",
        "key": "shift+f5",
        "when": "editorTextFocus && testbench.activeFile && (testbench.running || testbench.paused)"
      },
      {
        "command": "-workbench.action.debug.start",
        "key": "f5",
        "when": "editorTextFocus && testbench.activeFile"
      },
      {
        "command": "-workbench.action.debug.stop",
        "key": "shift+f5",
        "when": "editorTextFocus && testbench.activeFile"
      },
      {
        "command": "testbench.toggleBreakpoint",
        "key": "f9",
        "when": "editorTextFocus && testbench.activeFile"
      }
    ]
  },
  "scripts": {
    "typecheck:extension": "tsc -p tsconfig.extension.json --noEmit",
    "build:extension": "node esbuild.extension.js",
    "build:webview": "vite build --config vite.config.webview.js",
    "build": "npm run build:webview && npm run build:extension",
    "watch:extension": "node esbuild.extension.js --watch",
    "watch:webview": "vite build --config vite.config.webview.js --watch",
    "watch": "concurrently -n webview,extension -c blue,green \"npm:watch:webview\" \"npm:watch:extension\"",
    "dev": "npm run build && code --extensionDevelopmentPath=.",
    "package": "vsce package --no-dependencies",
    "test": "node --test tests/*.test.js",
    "test:integration": "npm run build && node tests/integration/runTest.cjs",
    "test:live": "npm run build && node tests/integration/runLiveTest.cjs"
  },
  "dependencies": {
    "ai-ui-automation-runner-core": "file:../runner-core",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  }
}
