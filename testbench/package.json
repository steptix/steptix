{
  "name": "testbench",
  "displayName": "TestBench",
  "publisher": "pkent",
  "version": "0.1.0",
  "description": "Edit and run ai-ui-automation natural-language tests inside VS Code",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension/extension.js",
  "categories": [
    "Other",
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "testbench.editor",
        "displayName": "TestBench",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "TestBench",
      "properties": {
        "testbench.defaultEnvFile": {
          "type": "string",
          "default": "",
          "description": "Absolute or workspace-relative path used when walk-up finds no .env next to (or above) the test file."
        },
        "testbench.editor.wordWrap": {
          "type": "boolean",
          "default": true,
          "description": "Wrap long lines in the TestBench editor."
        },
        "testbench.openMarkdownAsTest": {
          "type": "boolean",
          "default": true,
          "description": "Open Markdown files containing a '## Steps' heading in the TestBench editor by default. Disable to keep all .md files in the plain editor."
        }
      }
    },
    "commands": [
      { "command": "testbench.runSelected", "title": "TestBench: Run Selected Step(s)" },
      { "command": "testbench.runAll", "title": "TestBench: Run All Steps" },
      { "command": "testbench.stop", "title": "TestBench: Stop Run" },
      { "command": "testbench.toggleBreakpoint", "title": "TestBench: Toggle Breakpoint" },
      { "command": "testbench.reopenAsText", "title": "TestBench: Reopen as Plain Markdown" },
      { "command": "testbench.revealEnvFile", "title": "TestBench: Reveal Resolved .env" },
      { "command": "testbench.showRunLog", "title": "TestBench: Show Run Log" },
      { "command": "testbench.dismissError", "title": "TestBench: Dismiss Error" }
    ],
    "keybindings": [
      {
        "command": "testbench.runSelected",
        "key": "f5",
        "when": "resourceExtname == .md && activeCustomEditorId == testbench.editor"
      },
      {
        "command": "-workbench.action.debug.start",
        "key": "f5",
        "when": "resourceExtname == .md && activeCustomEditorId == testbench.editor"
      }
    ]
  },
  "scripts": {
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:webview": "vite build --config vite.config.webview.js",
    "build": "npm run build:webview && npm run build:extension",
    "watch:extension": "tsc -p tsconfig.extension.json --watch",
    "watch:webview": "vite build --config vite.config.webview.js --watch",
    "watch": "concurrently -n webview,extension -c blue,green \"npm:watch:webview\" \"npm:watch:extension\"",
    "dev": "npm run build && code --extensionDevelopmentPath=.",
    "package": "vsce package --no-dependencies",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "ai-ui-automation-runner-core": "file:../runner-core",
    "monaco-editor": "^0.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^3.2.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  }
}
