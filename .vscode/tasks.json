{
  "version": "2.0.0",
  "tasks": [
    {
      // The preLaunchTask for "Run TestBench Extension". `npm run build` in
      // testbench-native builds runner-core, the webview and the extension
      // bundle, so F5 always launches the code you are looking at.
      "label": "npm: build - testbench-native",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/testbench-native" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    }
  ]
}
