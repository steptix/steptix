{
  "version": "0.2.0",
  "configurations": [
    {
      // CLAUDE.md says to run a dev host rather than installing from a
      // worktree, because `~/.vscode/extensions/` is machine-global and two
      // checkouts collide there. This is how you launch one. F5 rather than the
      // CLI on purpose: `code --extensionDevelopmentPath=…` is handed to an
      // already-running VS Code, which drops the flag and opens a plain window.
      // The preLaunchTask matters for the same reason the version bump does —
      // without it F5 loads whatever `dist/` happens to be on disk, which is
      // the stale-build trap in a different costume.
      "name": "Run TestBench Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "npm: build - testbench-native",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/testbench-native"],
      "outFiles": ["${workspaceFolder}/testbench-native/dist/**/*.js"]
    },
    {
      "name": "Debug Test File",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "args": [
        "src/index.ts",
        "run",
        "${file}",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_NO_WARNINGS": "1"
      }
    }
  ]
}
