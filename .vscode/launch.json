{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Test File",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "args": [
        "src/index.ts",
        "run",
        "${file}",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_NO_WARNINGS": "1"
      }
    }
  ]
}
