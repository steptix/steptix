# Created at runtime by env-overlay.test.cjs; its teardown is best-effort
# (Windows EBUSY), so it can survive a run.
tests/integration/fixtures/sub/
# Runtime-generated fixture projects (created in before(), removed in after()).
# Listed so a killed electron host cannot leave one behind to be committed —
# or picked up as a real test by a later discovery scan.
tests/integration/fixtures/snc-project/
tests/integration/fixtures/dc-project/
tests/integration/fixtures/sac-project/

# Remembered wall-clock per live test file, used to start the slow ones first.
# A local timing hint, not a fact about the code — machine-specific, and stale
# the moment a suite gets slower.
tests/integration/live-durations.json
# Ports+pids of the shard servers a parallel run owns, so the next run can
# clean up after a Ctrl+Break that skipped the exit hook.
tests/integration/live-servers.json
