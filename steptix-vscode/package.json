    "menus": {
      "view/title": [
        {
          "command": "steptix.openLastReport",
          "when": "view == steptix.runner",
          "group": "navigation@1"
        },
        {
          "command": "steptix.openInEditor",
          "when": "view == steptix.runner",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "steptix.runSelected",
          "when": "steptix.activeFile && !steptix.running && !steptix.paused && !steptix.recording",
          "group": "navigation@1"
        },
        {
          "command": "steptix.pause",
          "when": "steptix.activeFile && steptix.running && !steptix.stepPaused",
          "group": "navigation@1"
        },
        {
          "command": "steptix.continueRun",
          "when": "steptix.activeFile && (steptix.stepPaused || (steptix.paused && !steptix.running))",
          "group": "navigation@1"
        },
        {
          "command": "steptix.stepOver",
          "when": "steptix.activeFile && (steptix.stepPaused || (steptix.paused && !steptix.running))",
          "group": "navigation@2"
        },
        {
          "command": "steptix.stepInto",
          "when": "steptix.activeFile && (steptix.stepPaused || (steptix.paused && !steptix.running))",
          "group": "navigation@3"
        },
        {
          "command": "steptix.stepOut",
          "when": "steptix.activeFile && steptix.stepPaused",
          "group": "navigation@4"
        },
        {
          "command": "steptix.stop",
          "when": "steptix.activeFile && (steptix.running || steptix.paused)",
          "group": "navigation@5"
        },
        {
          "command": "steptix.restartSession",
          "when": "steptix.activeFile && !steptix.recording",
          "group": "navigation@6"
        },
        {
          "command": "steptix.runAndCompile",
          "when": "steptix.activeFile && !steptix.running && !steptix.recording",
          "group": "navigation@7"
        },
        {
          "command": "steptix.applyCodeBehind",
          "when": "steptix.codeBehindProposal",
          "group": "navigation@8"
        },
        {
          "command": "steptix.discardCodeBehind",
          "when": "steptix.codeBehindProposal",
          "group": "navigation@9"
        },
        {
          "command": "steptix.recordSteps",
          "when": "steptix.activeFile && !steptix.recording && (!steptix.running || steptix.stepPaused)",
          "group": "navigation@10"
        },
        {
          "command": "steptix.recordAddCheck",
          "when": "steptix.recording",
          "group": "navigation@1"
        },
        {
          "command": "steptix.stopRecording",
          "when": "steptix.recording",
          "group": "navigation@2"
        },
        {
          "command": "steptix.pauseRecording",
          "when": "steptix.recording && !steptix.recordingPaused",
          "group": "navigation@3"
        },
        {
          "command": "steptix.resumeRecording",
          "when": "steptix.recordingPaused",
          "group": "navigation@3"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "steptix.toggleBreakpoint",
          "when": "steptix.activeFile",
          "group": "1_breakpoint@1"
        },
        {
          "command": "steptix.runStepHere",
          "when": "steptix.activeFile",
          "group": "2_run@1"
        },
        {
          "command": "steptix.runRow",
          "when": "steptix.activeFile && editorLineNumber in steptix.dataRowLines",
          "group": "2_run@2"
        },
        {
          "command": "steptix.repairStep",
          "when": "steptix.activeFile && editorLineNumber in steptix.staleStepLines",
          "group": "2_run@2"
        },
        {
          "command": "steptix.compileStepCodeBehind",
          "when": "steptix.activeFile",
          "group": "2_run@3"
        },
        {
          "command": "steptix.openCodeBehind",
          "when": "steptix.activeFile",
          "group": "2_run@4"
        },
        {
          "command": "steptix.renumberSteps",
          "when": "steptix.activeFile",
          "group": "2z_edit@1"
        },
        {
          "command": "steptix.clearBreakpoints",
          "when": "steptix.activeFile",
          "group": "3_clear@1"
        },
        {
          "command": "steptix.clearStatuses",
          "when": "steptix.activeFile",
          "group": "3_clear@2"
        }
      ],
      "editor/context": [
        {
          "command": "steptix.runSkillStepsOnStoppedSession",
          "when": "steptix.skillDebugActive && editorLangId == markdown",
          "group": "2_run@1"
        }
      ],
      "commandPalette": [
        {
          "command": "steptix.runSkillStepsOnStoppedSession",
          "when": "steptix.skillDebugActive"
        },
        {
          "command": "steptix.repairStep",
          "when": "steptix.activeFile && steptix.hasStaleStep"
        },
        {
          "command": "steptix.runRow",
          "when": "false"
        },
        {
          "command": "steptix.runRows",
          "when": "steptix.activeFile"
        },
        {
          "command": "steptix.rerunFailedRows",
          "when": "steptix.activeFile && steptix.hasFailedRows"
        },
        {
          "command": "steptix.renumberSteps",
          "when": "steptix.activeFile"
        },
        {
          "command": "steptix.applyCodeBehind",
          "when": "steptix.codeBehindProposal"
        },
        {
          "command": "steptix.discardCodeBehind",
          "when": "steptix.codeBehindProposal"
        },
        {
          "command": "steptix.compileCodeBehind",
          "when": "false"
        },
        {
          "command": "steptix.recordSteps",
          "when": "steptix.activeFile && !steptix.recording"
        },
        {
          "command": "steptix.recordNewTest",
          "when": "!steptix.recording"
        },
        {
          "command": "steptix.stopRecording",
          "when": "steptix.recording"
        },
        {
          "command": "steptix.recordAddCheck",
          "when": "steptix.recording"
        },
        {
          "command": "steptix.cancelRecording",
          "when": "steptix.recording"
        },
        {
          "command": "steptix.pauseRecording",
          "when": "steptix.recording && !steptix.recordingPaused"
        },
        {
          "command": "steptix.resumeRecording",
          "when": "steptix.recordingPaused"
        },
        {
          "command": "steptix.addStepToRecording",
          "when": "steptix.recording"
        }
      ]
    },
    "keybindings": [
      {
        "command": "steptix.runSelected",
        "key": "f5",
        "when": "editorTextFocus && steptix.activeFile && !steptix.running && !steptix.paused && !steptix.recording"
      },
      {
        "command": "steptix.pause",
        "key": "f5",
        "when": "editorTextFocus && steptix.activeFile && steptix.running && !steptix.stepPaused"
      },
      {
        "command": "steptix.continueRun",
        "key": "f5",
        "when": "editorTextFocus && steptix.activeFile && (steptix.stepPaused || (steptix.paused && !steptix.running))"
      },
      {
        "command": "steptix.stop",
        "key": "shift+f5",
        "when": "editorTextFocus && steptix.activeFile && (steptix.running || steptix.paused)"
      },
      {
        "command": "-workbench.action.debug.start",
        "key": "f5",
        "when": "editorTextFocus && steptix.activeFile"
      },
      {
        "command": "-workbench.action.debug.stop",
        "key": "shift+f5",
        "when": "editorTextFocus && steptix.activeFile"
      },
      {
        "command": "steptix.toggleBreakpoint",
        "key": "f9",
        "when": "editorTextFocus && steptix.activeFile"
      },
      {
        "command": "steptix.stepInto",
        "key": "f11",
        "when": "editorTextFocus && steptix.activeFile && (!steptix.running || steptix.stepPaused)"
      },
      {
        "command": "steptix.stepOver",
        "key": "f10",
        "when": "editorTextFocus && steptix.activeFile && (steptix.stepPaused || (steptix.paused && !steptix.running))"
      },
      {
        "command": "steptix.stepOut",
        "key": "shift+f11",
        "when": "editorTextFocus && steptix.activeFile && steptix.stepPaused"
      }
    ]
  },
  "scripts": {
    "typecheck:extension": "tsc -p tsconfig.extension.json --noEmit",
    "copy:schema": "node -e \"const fs=require('fs');fs.mkdirSync('schema',{recursive:true});fs.copyFileSync('../schema/steptix.config.schema.json','schema/steptix.config.schema.json')\"",
    "build:runner-core": "npm run build --prefix ../runner-core",
    "build:extension": "node esbuild.extension.js",
    "build:webview": "vite build --config vite.config.webview.js",
    "build:notices": "node scripts/third-party-notices.mjs",
    "build": "npm run build:runner-core && npm run copy:schema && npm run build:webview && npm run build:extension && npm run build:notices",
    "watch:extension": "node esbuild.extension.js --watch",
    "watch:webview": "vite build --config vite.config.webview.js --watch",
    "watch": "concurrently -n webview,extension -c blue,green \"npm:watch:webview\" \"npm:watch:extension\"",
    "dev": "npm run build && code --extensionDevelopmentPath=.",
    "package": "npm run build:notices && vsce package --no-dependencies --pre-release",
    "pretest": "npm run build --prefix .. && npm run build:runner-core",
    "test": "node --test tests/*.test.js",
    "test:integration": "npm run build && node tests/integration/runTest.cjs",
    "test:live": "npm run build && node tests/integration/runLiveTest.cjs"
  },
  "dependencies": {
    "steptix-runner-core": "file:../runner-core",
    "jsonc-parser": "^3.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "mocha": "^10.8.2",
    "playwright-core": "^1.59.1",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
