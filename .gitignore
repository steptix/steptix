node_modules/
dist/
dist-ui/
dist-runtime/
build-tools/
reports/
memory/
# Written by the step cache, which was removed. Still ignored so a checkout
# that has an old one never stages it — it is safe to delete.
.cache/
# Temp tool modules written by the server's hot-reload (issue 033). Created
# inside the tools dir as a dot-dir; files are deleted right after import, so
# this is normally empty, but ignore it so a stray temp .mjs never gets staged.
.steptix-tool-cache/
# Same thing for step code-behind: temp `.mjs` bundles written beside a
# `.steps.ts` so it can be imported (and validated) with fresh code. The
# `.steps.ts` files themselves ARE committed — that is the point of the
# feature; only this dot-dir is transient.
.steptix-codebehind-cache/
# Per-machine state at any depth: the MCP server's rolling log of servers it
# auto-started (mcp-server.log, which holds whatever the server printed — step
# text and resolved values included — so it must never be committed), CDP
# profiles, and the extension's run-state.json (gutter ✓/✗ marks; travels in
# the project zip but stays out of git to avoid churn).
.steptix/
*.tsbuildinfo
# Unit-test scratch dirs. In-repo because code-behind bundles resolve the
# package from there; each run removes its own, but a killed run leaves one.
tests/.tmp-*/
.env
.env.*
!.env.example
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Steptix (VS Code extension)
steptix-vscode/.vscode-test/
steptix-vscode/*.vsix

# flick-vscode CDP launcher's per-engine browser profiles. Created when the
# user clicks "Launch with CDP" — full Chrome/Edge user-data-dir (cookies,
# cache, etc), per-machine, may carry session state.
.flick/
flick-vscode/*.vsix

# Parallel live-suite scratch: one directory per shard, holding that shard's
# copy of templates/, its VS Code user-data/extensions dirs, its server log and
# its per-file reports. Wiped and rebuilt at the start of every parallel run.
# Beside templates/ rather than under steptix-vscode/ so a shard workspace
# resolves bare imports through the same node_modules chain the real one does.
.live-shards/
