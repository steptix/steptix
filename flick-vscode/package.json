{
  "name": "flick-vscode",
  "displayName": "Flick",
  "publisher": "pkent",
  "version": "0.1.1",
  "description": "Send natural-language UI steps to the ai-ui-automation Sessions API from a chat panel inside VS Code.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/pkent/ai-ui-automation"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension/extension.js",
  "categories": [
    "Other",
    "Testing"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flick",
          "title": "Flick",
          "icon": "./icons/flick.svg"
        }
      ]
    },
    "views": {
      "flick": [
        {
          "id": "flick.chat",
          "name": "Sessions",
          "type": "webview",
          "icon": "./icons/flick.svg",
          "contextualTitle": "Flick"
        }
      ]
    },
    "configuration": {
      "title": "Flick",
      "properties": {
        "flick.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3100",
          "description": "Full URL of the ai-ui-automation Sessions API server."
        },
        "flick.apiKey": {
          "type": "string",
          "default": "",
          "description": "The x-api-key value sent with every request to the Sessions API."
        },
        "flick.defaultBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Default config.baseUrl applied to the first request of each new session. Leave blank to use server defaults."
        },
        "flick.defaultTimeout": {
          "type": "string",
          "default": "",
          "description": "Default config.timeout applied to the first request of each new session (e.g. \"30s\"). Leave blank to use server defaults."
        }
      }
    },
    "commands": [
      {
        "command": "flick.newSession",
        "title": "Flick: New Session",
        "icon": "$(add)"
      },
      {
        "command": "flick.focus",
        "title": "Flick: Focus Sessions Panel"
      },
      {
        "command": "flick.openSettings",
        "title": "Flick: Open Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flick.newSession",
          "when": "view == flick.chat",
          "group": "navigation@1"
        },
        {
          "command": "flick.openSettings",
          "when": "view == flick.chat",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "dev": "npm run build && code --extensionDevelopmentPath=.",
    "package": "vsce package --no-dependencies",
    "build:test": "node esbuild.test.js",
    "test": "node esbuild.test.js && node --test \"dist-test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.0"
  }
}
