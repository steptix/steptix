{
  "$schema": "https://raw.githubusercontent.com/nicoh-at/tauri-v2-schema/refs/heads/main/src/tauri.conf.json",
  "productName": "Flick",
  "version": "0.1.0",
  "identifier": "com.ai-ui-automation.flick",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Flick",
        "width": 420,
        "height": 300,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "minWidth": 360,
        "minHeight": 250
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
