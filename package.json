{
  "name": "ai-ui-automation",
  "version": "1.0.0",
  "description": "AI-powered UI test automation using natural language Markdown test files",
  "type": "module",
  "bin": {
    "aiui": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    },
    "./codebehind": {
      "types": "./dist/codebehind/index.d.ts",
      "import": "./dist/codebehind/index.js",
      "default": "./dist/codebehind/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:schema && tsc && node -e \"require('fs').cpSync('src/browser/scripts','dist/browser/scripts',{recursive:true})\"",
    "build:schema": "node scripts/build-schema.mjs",
    "build:watch": "tsc --watch",
    "build:ui": "vite build --config src/ui/renderer/vite.config.ts",
    "build:all": "npm run build && npm run build:ui",
    "dev": "tsx src/index.ts",
    "dev:debug": "node --inspect --import tsx src/index.ts serve",
    "dev:ui": "concurrently \"vite --config src/ui/renderer/vite.config.ts\" \"sleep 2 && VITE_DEV_SERVER_URL=http://localhost:5173 electron dist/ui/main/index.js\"",
    "ui": "npm run build:all && env -u ELECTRON_RUN_AS_NODE electron --no-sandbox --ozone-platform-hint=auto dist/ui/main/index.cjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-ui',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pkent/aigateway": "1.4.0-beta.2",
    "@vitejs/plugin-react": "^6.0.1",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "electron": "^41.2.1",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "marked": "^18.0.2",
    "ora": "^9.3.0",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "prettier": "^3.9.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tiktoken": "^1.0.15",
    "tsx": "^4.7.0",
    "vite": "^8.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.4",
    "ajv": "^8.17.1",
    "concurrently": "^9.2.1",
    "electron-builder": "^26.8.1",
    "ts-json-schema-generator": "^2.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.21.0"
  }
}
